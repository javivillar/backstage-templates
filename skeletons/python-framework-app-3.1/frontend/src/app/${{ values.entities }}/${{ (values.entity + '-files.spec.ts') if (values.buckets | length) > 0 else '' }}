import { HttpTestingController } from '@angular/common/http/testing';
import { TestBed } from '@angular/core/testing';
import { provideRefresquitoTesting } from 'refresquito-angular/testing';
import { ADMIN, VIEWER } from '../roles';
import { API, request } from '../testing';
import { ${{ values.entityTitle }}Files } from './${{ values.entity }}-files';

describe('${{ values.entityTitle }}Files', () => {
  async function open(roles: string[]) {
    TestBed.configureTestingModule({ providers: [provideRefresquitoTesting({ user: { roles } })] });
    const fixture = TestBed.createComponent(${{ values.entityTitle }}Files);
    fixture.componentRef.setInput('id', 7);
    fixture.detectChanges();
    (await request('GET', `${API}/7/files`)).flush([{ id: 'rex.png', name: 'rex.png', size: 10 }]);
    await fixture.whenStable();
    fixture.detectChanges();
    return fixture.nativeElement as HTMLElement;
  }
  afterEach(() => TestBed.inject(HttpTestingController).verify());

  it('lists them; an admin may add one', async () => {
    const el = await open([ADMIN]);
    expect(el.querySelector('.rq-document-name')?.textContent?.trim()).toBe('rex.png');
    expect(el.querySelector('rq-file-upload')).not.toBeNull();
  });

  it('a viewer only reads them', async () => {
    const el = await open([VIEWER]);
    expect(el.querySelector('rq-file-upload')).toBeNull();
  });
});
