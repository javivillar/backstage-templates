{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Page_${{ values.Entity }}Out_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/${{ values.Entity }}Out"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "size"
        ],
        "title": "Page[${{ values.Entity }}Out]",
        "type": "object"
      },
      "${{ values.Entity }}In": {
        "properties": {
          "start_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          },
          "name": {
            "examples": [
              "Rex"
            ],
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "category": {
            "examples": [
              "tools"
            ],
            "maxLength": 40,
            "minLength": 1,
            "title": "Category",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/${{ values.Entity }}Status",
            "default": "active"
          }
        },
        "required": [
          "name",
          "category"
        ],
        "title": "${{ values.Entity }}In",
        "type": "object"
      },
      "${{ values.Entity }}Out": {
        "properties": {
          "start_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "title": "Created By",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/${{ values.Entity }}Status"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "status",
          "start_date",
          "created_at",
          "created_by"
        ],
        "title": "${{ values.Entity }}Out",
        "type": "object"
      },
      "${{ values.Entity }}Status": {
        "enum": [
          "active",
          "pending",
          "closed"
        ],
        "title": "${{ values.Entity }}Status",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Access token of the Keycloak realm",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "${{ values.title }} API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/${{ values.entities }}": {
      "get": {
        "operationId": "list_${{ values.entities }}_api_${{ values.entities }}_get",
        "parameters": [
          {
            "description": "Only the ${{ values.entities }} in this status",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/${{ values.Entity }}Status"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only the ${{ values.entities }} in this status",
              "title": "Status"
            }
          },
          {
            "description": "Only this category",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this category",
              "title": "Category"
            }
          },
          {
            "description": "Page number, from 1",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Page number, from 1",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Items per page",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Items per page",
              "maximum": 100,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_${{ values.Entity }}Out_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List ${{ values.Entities }}",
        "tags": [
          "${{ values.entities }}"
        ]
      },
      "post": {
        "operationId": "create_${{ values.entity }}_api_${{ values.entities }}_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/${{ values.Entity }}In"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/${{ values.Entity }}Out"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create ${{ values.Entity }}",
        "tags": [
          "${{ values.entities }}"
        ]
      }
    },
    "/api/${{ values.entities }}/{${{ values.entity }}_id}": {
      "delete": {
        "operationId": "delete_${{ values.entity }}_api_${{ values.entities }}__${{ values.entity }}_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "${{ values.entity }}_id",
            "required": true,
            "schema": {
              "title": "${{ values.Entity }} Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete ${{ values.Entity }}",
        "tags": [
          "${{ values.entities }}"
        ]
      },
      "get": {
        "operationId": "get_${{ values.entity }}_api_${{ values.entities }}__${{ values.entity }}_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "${{ values.entity }}_id",
            "required": true,
            "schema": {
              "title": "${{ values.Entity }} Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/${{ values.Entity }}Out"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get ${{ values.Entity }}",
        "tags": [
          "${{ values.entities }}"
        ]
      },
      "put": {
        "operationId": "update_${{ values.entity }}_api_${{ values.entities }}__${{ values.entity }}_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "${{ values.entity }}_id",
            "required": true,
            "schema": {
              "title": "${{ values.Entity }} Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/${{ values.Entity }}In"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/${{ values.Entity }}Out"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Update ${{ values.Entity }}",
        "tags": [
          "${{ values.entities }}"
        ]
      }
    }
  }
}
