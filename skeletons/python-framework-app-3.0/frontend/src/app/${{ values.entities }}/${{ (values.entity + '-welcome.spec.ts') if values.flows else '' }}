import { HttpTestingController } from '@angular/common/http/testing';
import { TestBed } from '@angular/core/testing';
import { NotificationService } from 'refresquito-angular';
import { provideRefresquitoTesting } from 'refresquito-angular/testing';
import { ADMIN } from '../roles';
import { API, request } from '../testing';
import { ${{ values.entityTitle }}Welcome } from './${{ values.entity }}-welcome';

describe('${{ values.entityTitle }}Welcome', () => {
  it('calls the API and tells the user what it answered', async () => {
    TestBed.configureTestingModule({ providers: [provideRefresquitoTesting({ user: { roles: [ADMIN] } })] });
    const success = spyOn(TestBed.inject(NotificationService), 'success');
    const fixture = TestBed.createComponent(${{ values.entityTitle }}Welcome);
    fixture.componentRef.setInput('id', 7);
    fixture.detectChanges();
    const button = fixture.nativeElement.querySelector('button') as HTMLButtonElement;
    expect(button.textContent).toBe('Welcome');
    button.click();
    (await request('POST', `${API}/7/welcome`)).flush({ message: 'Welcome, Rex the dog!' });
    expect(success).toHaveBeenCalledWith('Welcome, Rex the dog!');
    TestBed.inject(HttpTestingController).verify();
  });
});
