"""Block dms: the documents of a ${{ values.entity }}, in the Alfresco site `documents` of the ${{ values.name }}, a folder per ${{ values.entity }} (${{ values.entity }}/<id>).
The people of the site see the same documents in Alfresco."""

import os

from fastapi import APIRouter, Response, UploadFile
from refresquito_fastapi import NotFoundError
from refresquito_fastapi.db import SessionDep
from refresquito_fastapi.platform.dms import Document, DocumentsDep

from .api import Reader, Writer, find

router = APIRouter(prefix="/api/${{ values.entities }}/{${{ values.entity }}_id}/documents", tags=["documents"])
SITE = "${{ values.sites[0] }}"


@router.get("")
async def list_documents(${{ values.entity }}_id: int, user: Reader, session: SessionDep, documents: DocumentsDep) -> list[Document]:
    ${{ values.entity }} = await find(session, ${{ values.entity }}_id)
    site = documents.site(SITE)
    return await site.list(site.folder("${{ values.entity }}", ${{ values.entity }}.id))


@router.post("", status_code=201)
async def add_document(${{ values.entity }}_id: int, file: UploadFile, user: Writer, session: SessionDep,
                       documents: DocumentsDep) -> Document:
    ${{ values.entity }} = await find(session, ${{ values.entity }}_id)
    site = documents.site(SITE)
    return await site.upload(os.path.basename(file.filename or "document"), await file.read(),
                             folder=site.folder("${{ values.entity }}", ${{ values.entity }}.id), content_type=file.content_type)


@router.get("/{document_id}")
async def download_document(${{ values.entity }}_id: int, document_id: str, user: Reader, documents: DocumentsDep) -> Response:
    site = documents.site(SITE)
    stored = await site.content(document_id)
    if stored.document.folder != site.folder("${{ values.entity }}", ${{ values.entity }}_id):
        raise NotFoundError(f"${{ values.entityTitle }} {${{ values.entity }}_id} has no document {document_id}")
    return Response(stored.content, media_type=stored.document.mime_type or "application/octet-stream",
                    headers={"Content-Disposition": f'attachment; filename="{stored.document.name}"'})


@router.delete("/{document_id}", status_code=204)
async def delete_document(${{ values.entity }}_id: int, document_id: str, user: Writer, documents: DocumentsDep) -> None:
    site = documents.site(SITE)
    if (await site.get(document_id)).folder != site.folder("${{ values.entity }}", ${{ values.entity }}_id):
        raise NotFoundError(f"${{ values.entityTitle }} {${{ values.entity }}_id} has no document {document_id}")
    await site.delete(document_id)
