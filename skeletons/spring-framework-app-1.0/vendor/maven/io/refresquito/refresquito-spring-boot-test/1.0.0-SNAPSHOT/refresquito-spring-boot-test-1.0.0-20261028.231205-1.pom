<?xml version="1.0" encoding="UTF-8"?>
<!-- What the tests of a service use: tokens of the realm signed in the test, checked exactly as in production. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.refresquito</groupId>
    <artifactId>refresquito-spring-boot-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../parent</relativePath>
  </parent>
  <artifactId>refresquito-spring-boot-test</artifactId>
  <name>refresquito-spring-boot-test</name>
  <description>Testing support of the Spring framework of Refresquito: a token factory and the decoder that trusts it.</description>

  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId></dependency>
  </dependencies>
</project>
