        ],
        "x-refresquito-auth": {
          "kind": "roles",
          "owner": "app",
          "roles": [
            "${{ values.name }}-admin"
          ]
        },
        "x-refresquito-source": [
          "table:${{ values.entity }}"
        ],
        "x-refresquito-target": [
          "flow:new-${{ values.entity }}"
        ]
      }
    },
{%- endif %}
{%- if (values.dashboards) %}
    "/api/stats/${{ values.entities }}-by-status": {
      "get": {
        "operationId": "dashboards_${{ values.entities }}_by_status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": {},
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "dashboards-controller"
        ],
        "x-refresquito-auth": {
          "kind": "roles",
          "owner": "app",
          "roles": [
            "${{ values.name }}-admin",
            "${{ values.name }}-viewer"
          ]
        },
        "x-refresquito-source": [
          "table:${{ values.entity }}"
        ]
      }
    },
{%- endif %}
{%- if (values.processes) %}
    "/api/tasks": {
      "get": {
        "operationId": "review_tasks",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "review-controller"
        ],
        "x-refresquito-auth": {
          "kind": "roles",
          "owner": "app",
          "roles": [
            "${{ values.name }}-admin",
            "${{ values.name }}-viewer"
          ]
        },
        "x-refresquito-source": [
          "process:review"
        ]
      }
    },
{%- endif %}
{%- if (values.processes) %}
    "/api/tasks/{taskId}/complete": {
      "post": {
        "operationId": "review_complete",
        "parameters": [
          {
            "in": "path",
            "name": "taskId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": {},
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "tags": [
          "review-controller"
        ],
        "x-refresquito-auth": {
          "kind": "roles",
          "owner": "app",
          "roles": [
            "${{ values.name }}-admin",
            "${{ values.name }}-viewer"
          ]
        },
        "x-refresquito-target": [
          "process:review"
        ]
      }
    },
{%- endif %}
    "/api/${{ values.entities }}": {
      "get": {
        "operationId": "${{ values.entities }}_list",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
