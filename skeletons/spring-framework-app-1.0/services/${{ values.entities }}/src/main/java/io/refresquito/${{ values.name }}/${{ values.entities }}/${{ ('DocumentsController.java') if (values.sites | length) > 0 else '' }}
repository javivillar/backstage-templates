package io.refresquito.${{ values.name }}.${{ values.entities }};

import java.io.IOException;
import java.util.List;

import io.refresquito.spring.dms.Content;
import io.refresquito.spring.dms.Document;
import io.refresquito.spring.dms.Documents;
import io.refresquito.spring.error.RefresquitoException;
import io.refresquito.spring.openapi.Lineage;
import jakarta.annotation.security.RolesAllowed;
import org.springframework.beans.factory.ObjectProvider;
import org.springframework.http.ContentDisposition;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.ResponseStatus;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.multipart.MultipartFile;

import static io.refresquito.${{ values.name }}.${{ values.entities }}.${{ values.entitiesTitle }}Application.ADMIN;
import static io.refresquito.${{ values.name }}.${{ values.entities }}.${{ values.entitiesTitle }}Application.VIEWER;

/** Block dms: the documents of a ${{ values.entity }}, in the Alfresco site `documents`, a folder per ${{ values.entity }} (${{ values.entity }}/<id>). */
@RestController
@RequestMapping("/api/${{ values.entities }}/{id}/documents")
public class DocumentsController {

    static final String SITE = "${{ values.sites[0] }}";

    private final ${{ values.entitiesTitle }}Controller ${{ values.entities }};
    private final ObjectProvider<Documents> documents;

    DocumentsController(${{ values.entitiesTitle }}Controller ${{ values.entities }}, ObjectProvider<Documents> documents) {
        this.${{ values.entities }} = ${{ values.entities }};
        this.documents = documents;
    }

    private Documents.Site site() {
        return Blocks.required(documents, "dms").site(SITE);
    }

    @GetMapping
    @RolesAllowed({VIEWER, ADMIN})
    @Lineage(source = "site:${{ values.sites[0] }}")
    public List<Document> list(@PathVariable long id) {
        ${{ values.entities }}.find(id);
        return site().list(Documents.folder("${{ values.entity }}", id));
    }

    @PostMapping
    @ResponseStatus(HttpStatus.CREATED)
    @RolesAllowed(ADMIN)
    @Lineage(target = "site:${{ values.sites[0] }}")
    public Document add(@PathVariable long id, @RequestParam("file") MultipartFile file) throws IOException {
        ${{ values.entities }}.find(id);
        return site().upload(Blocks.basename(file.getOriginalFilename(), "document"), file.getBytes(),
                Documents.folder("${{ values.entity }}", id), file.getContentType());
    }

    @GetMapping("/{document}")
    @RolesAllowed({VIEWER, ADMIN})
    @Lineage(source = "site:${{ values.sites[0] }}")
    public ResponseEntity<byte[]> download(@PathVariable long id, @PathVariable String document) {
        Content content = site().content(document);
        if (!content.document().folder().equals(Documents.folder("${{ values.entity }}", id))) {
            throw new RefresquitoException.NotFound("${{ values.entityTitle }} " + id + " has no document " + document);
        }
        String type = content.document().mimeType() != null ? content.document().mimeType() : "application/octet-stream";
        return ResponseEntity.ok().contentType(MediaType.parseMediaType(type))
                .header(HttpHeaders.CONTENT_DISPOSITION, ContentDisposition.attachment().filename(content.document().name()).build().toString())
                .body(content.content());
    }

    @DeleteMapping("/{document}")
    @ResponseStatus(HttpStatus.NO_CONTENT)
    @RolesAllowed(ADMIN)
    @Lineage(target = "site:${{ values.sites[0] }}")
    public void delete(@PathVariable long id, @PathVariable String document) {
        Documents.Site site = site();
        if (!site.get(document).folder().equals(Documents.folder("${{ values.entity }}", id))) {
            throw new RefresquitoException.NotFound("${{ values.entityTitle }} " + id + " has no document " + document);
        }
        site.delete(document);
    }
}
